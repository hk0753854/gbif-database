{
  "datasets": [
    {
      "name": "geographic_summary",
      "displayName": "Geographic Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.geographic_summary",
        "dimensions": [
          {
            "name": "latitude_grid",
            "expr": "latitude_grid"
          },
          {
            "name": "longitude_grid",
            "expr": "longitude_grid"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "countryCode",
            "expr": "countryCode"
          },
          {
            "name": "stateProvince",
            "expr": "stateProvince"
          },
          {
            "name": "stateProvinceCode",
            "expr": "CASE \n  WHEN stateProvince = 'Hokkaido' THEN '01'\n  WHEN stateProvince = 'Aomori' THEN '02'\n  WHEN stateProvince = 'Iwate' THEN '03'\n  WHEN stateProvince = 'Miyagi' THEN '04'\n  WHEN stateProvince = 'Akita' THEN '05'\n  WHEN stateProvince = 'Yamagata' THEN '06'\n  WHEN stateProvince = 'Fukushima' THEN '07'\n  WHEN stateProvince = 'Ibaraki' THEN '08'\n  WHEN stateProvince = 'Tochigi' THEN '09'\n  WHEN stateProvince = 'Gunma' THEN '10'\n  WHEN stateProvince = 'Saitama' THEN '11'\n  WHEN stateProvince = 'Chiba' THEN '12'\n  WHEN stateProvince = 'Tokyo' THEN '13'\n  WHEN stateProvince = 'Kanagawa' THEN '14'\n  WHEN stateProvince = 'Niigata' THEN '15'\n  WHEN stateProvince = 'Toyama' THEN '16'\n  WHEN stateProvince = 'Ishikawa' THEN '17'\n  WHEN stateProvince = 'Fukui' THEN '18'\n  WHEN stateProvince = 'Yamanashi' THEN '19'\n  WHEN stateProvince = 'Nagano' THEN '20'\n  WHEN stateProvince = 'Gifu' THEN '21'\n  WHEN stateProvince = 'Shizuoka' THEN '22'\n  WHEN stateProvince = 'Aichi' THEN '23'\n  WHEN stateProvince = 'Mie' THEN '24'\n  WHEN stateProvince = 'Shiga' THEN '25'\n  WHEN stateProvince = 'Kyoto' THEN '26'\n  WHEN stateProvince = 'Osaka' THEN '27'\n  WHEN stateProvince = 'Hyōgo' OR stateProvince = 'Hyogo' THEN '28'\n  WHEN stateProvince = 'Nara' THEN '29'\n  WHEN stateProvince = 'Wakayama' THEN '30'\n  WHEN stateProvince = 'Tottori' THEN '31'\n  WHEN stateProvince = 'Shimane' THEN '32'\n  WHEN stateProvince = 'Okayama' THEN '33'\n  WHEN stateProvince = 'Hiroshima' THEN '34'\n  WHEN stateProvince = 'Yamaguchi' THEN '35'\n  WHEN stateProvince = 'Tokushima' THEN '36'\n  WHEN stateProvince = 'Kagawa' THEN '37'\n  WHEN stateProvince = 'Ehime' THEN '38'\n  WHEN stateProvince = 'Kochi' THEN '39'\n  WHEN stateProvince = 'Fukuoka' THEN '40'\n  WHEN stateProvince = 'Saga' THEN '41'\n  WHEN stateProvince = 'Nagasaki' THEN '42'\n  WHEN stateProvince = 'Kumamoto' THEN '43'\n  WHEN stateProvince = 'Oita' THEN '44'\n  WHEN stateProvince = 'Miyazaki' THEN '45'\n  WHEN stateProvince = 'Kagoshima' THEN '46'\n  WHEN stateProvince = 'Okinawa' THEN '47'\n  ELSE NULL \nEND\n"
          },
          {
            "name": "county",
            "expr": "county"
          },
          {
            "name": "municipality",
            "expr": "municipality"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          }
        ]
      }
    },
    {
      "name": "observation_type_summary",
      "displayName": "Observation Type Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.observation_type_summary",
        "dimensions": [
          {
            "name": "basis_of_record",
            "expr": "basisOfRecord"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          }
        ]
      }
    },
    {
      "name": "species_summary",
      "displayName": "Species Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.species_summary",
        "dimensions": [
          {
            "name": "scientific_name",
            "expr": "scientificName"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          },
          {
            "name": "taxonomic_group",
            "expr": "taxonomic_group"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          },
          {
            "name": "unique_species",
            "expr": "COUNT(DISTINCT scientificName)"
          }
        ]
      }
    },
    {
      "name": "country_summary",
      "displayName": "Country Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.country_summary",
        "dimensions": [
          {
            "name": "countryCode",
            "expr": "countryCode"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          },
          {
            "name": "unique_countries",
            "expr": "COUNT(DISTINCT countryCode)"
          }
        ]
      }
    }
  ],
