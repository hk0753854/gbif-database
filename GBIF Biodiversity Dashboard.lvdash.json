{
  "datasets": [
    {
      "name": "geographic_summary",
      "displayName": "Geographic Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.geographic_summary",
        "dimensions": [
          {
            "name": "latitude_grid",
            "expr": "latitude_grid"
          },
          {
            "name": "longitude_grid",
            "expr": "longitude_grid"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "countryCode",
            "expr": "countryCode"
          },
          {
            "name": "stateProvince",
            "expr": "stateProvince"
          },
          {
            "name": "county",
            "expr": "county"
          },
          {
            "name": "municipality",
            "expr": "municipality"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          }
        ]
      }
    },
    {
      "name": "observation_type_summary",
      "displayName": "Observation Type Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.observation_type_summary",
        "dimensions": [
          {
            "name": "basis_of_record",
            "expr": "basisOfRecord"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          }
        ]
      }
    },
    {
      "name": "species_summary",
      "displayName": "Species Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.species_summary",
        "dimensions": [
          {
            "name": "scientific_name",
            "expr": "scientificName"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          },
          {
            "name": "taxonomic_group",
            "expr": "taxonomic_group"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          },
          {
            "name": "unique_species",
            "expr": "COUNT(DISTINCT scientificName)"
          }
        ]
      }
    },
    {
      "name": "country_summary",
      "displayName": "Country Summary",
      "config": {
        "version": "1.1",
        "source": "workspace.gold.country_summary",
        "dimensions": [
          {
            "name": "countryCode",
            "expr": "countryCode"
          },
          {
            "name": "query_scientific_name",
            "expr": "query_scientific_name"
          },
          {
            "name": "japanese_name",
            "expr": "japanese_name"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "SUM(observations)"
          },
          {
            "name": "unique_countries",
            "expr": "COUNT(DISTINCT countryCode)"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "678cb6b9",
      "displayName": "GBIF Biodiversity Dashboard",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# GBIF Biodiversity Data Dashboard"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "counter_observations",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "species_summary",
                  "fields": [
                    {
                      "name": "measure(total_observations)",
                      "expression": "MEASURE(`total_observations`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Total Observations",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(total_observations)",
                  "rowNumber": 0
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "counter_species",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "species_summary",
                  "fields": [
                    {
                      "name": "measure(unique_species)",
                      "expression": "MEASURE(`unique_species`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Species Count",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(unique_species)",
                  "rowNumber": 0
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 4,
            "y": 1,
            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "counter_countries",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "country_summary",
                  "fields": [
                    {
                      "name": "measure(unique_countries)",
                      "expression": "MEASURE(`unique_countries`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Countries",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(unique_countries)",
                  "rowNumber": 0
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 8,
            "y": 1,
            "width": 4,
            "height": 2
          }
        },
        {
          "widget": {
            "name": "species_chart",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "species_summary",
                  "fields": [
                    {
                      "name": "scientific_name",
                      "expression": "`scientific_name`"
                    },
                    {
                      "name": "measure(total_observations)",
                      "expression": "MEASURE(`total_observations`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "title": "Observations by Species",
                "showTitle": true
              },
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "scientific_name",
                  "displayName": "Scientific Name",
                  "scale": {
                    "type": "categorical"
                  }
                },
                "y": {
                  "fieldName": "measure(total_observations)",
                  "displayName": "Total Observations",
                  "scale": {
                    "type": "quantitative"
                  }
                },
                "color": {
                  "fieldName": "scientific_name",
                  "displayName": "Scientific Name",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "type_chart",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "observation_type_summary",
                  "fields": [
                    {
                      "name": "measure(total_observations)",
                      "expression": "MEASURE(`total_observations`)"
                    },
                    {
                      "name": "basis_of_record",
                      "expression": "`basis_of_record`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 3,
              "frame": {
                "title": "Observation Type",
                "showTitle": true
              },
              "widgetType": "pie",
              "encodings": {
                "angle": {
                  "fieldName": "measure(total_observations)",
                  "scale": {
                    "type": "quantitative"
                  },
                  "displayName": "Total Observations"
                },
                "color": {
                  "fieldName": "basis_of_record",
                  "displayName": "Observation Type",
                  "scale": {
                    "type": "categorical"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 6,
            "width": 6,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "country_map",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "country_summary",
                  "fields": [
                    {
                      "name": "measure(total_observations)",
                      "expression": "MEASURE(`total_observations`)"
                    },
                    {
                      "name": "countryCode",
                      "expression": "`countryCode`"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 1,
              "widgetType": "choropleth-map",
              "encodings": {
                "extra": [
                  {
                    "fieldName": "measure(total_observations)"
                  }
                ],
                "region": {
                  "regionType": "mapbox-v4-admin",
                  "admin0": {
                    "fieldName": "countryCode",
                    "type": "field",
                    "geographicRole": "admin0-unit-code"
                  }
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 6,
            "y": 6,
            "width": 6,
            "height": 4
          }
        },
        {
          "widget": {
            "name": "geographic_summary_table",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "geographic_summary",
                  "fields": [
                    {
                      "name": "japanese_name",
                      "expression": "`japanese_name`"
                    },
                    {
                      "name": "stateProvince",
                      "expression": "`stateProvince`"
                    },
                    {
                      "name": "county",
                      "expression": "`county`"
                    },
                    {
                      "name": "municipality",
                      "expression": "`municipality`"
                    },
                    {
                      "name": "latitude_grid",
                      "expression": "`latitude_grid`"
                    },
                    {
                      "name": "longitude_grid",
                      "expression": "`longitude_grid`"
                    },
                    {
                      "name": "measure(total_observations)",
                      "expression": "MEASURE(`total_observations`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 1,
              "frame": {
                "title": "Observations by Location",
                "showTitle": true
              },
              "widgetType": "table",
              "encodings": {
                "columns": [
                  {
                    "fieldName": "japanese_name",
                    "displayName": "Species"
                  },
                  {
                    "fieldName": "stateProvince",
                    "displayName": "State / Province"
                  },
                  {
                    "fieldName": "county",
                    "displayName": "County"
                  },
                  {
                    "fieldName": "municipality",
                    "displayName": "Municipality"
                  },
                  {
                    "fieldName": "latitude_grid",
                    "displayName": "Latitude"
                  },
                  {
                    "fieldName": "longitude_grid",
                    "displayName": "Longitude"
                  },
                  {
                    "fieldName": "measure(total_observations)",
                    "displayName": "Observations"
                  }
                ]
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 10,
            "width": 12,
            "height": 6
          }
        }
      ],
      "pageType": "PAGE_TYPE_CANVAS",
      "layoutVersion": "GRID_V1"
    }
  ],
  "uiSettings": {
    "theme": {
      "widgetHeaderAlignment": "ALIGNMENT_UNSPECIFIED"
    },
    "applyModeEnabled": false
  }
}