{
  "datasets": [
    {
      "name": "gbif_data",
      "displayName": "GBIF Occurrences",
      "config": {
        "version": "1.1",
        "source": "workspace.silver.gbif_occurrences",
        "dimensions": [
          {
            "name": "species",
            "expr": "species"
          },
          {
            "name": "scientific_name",
            "expr": "scientificName"
          },
          {
            "name": "country",
            "expr": "country"
          },
          {
            "name": "event_year",
            "expr": "event_year"
          },
          {
            "name": "basis_of_record",
            "expr": "basisOfRecord"
          },
          {
            "name": "latitude",
            "expr": "decimalLatitude"
          },
          {
            "name": "longitude",
            "expr": "decimalLongitude"
          }
        ],
        "measures": [
          {
            "name": "total_observations",
            "expr": "COUNT(*)"
          },
          {
            "name": "unique_species",
            "expr": "COUNT(DISTINCT species)"
          },
          {
            "name": "unique_countries",
            "expr": "COUNT(DISTINCT country)"
          }
        ]
      }
    }
  ],
  "pages": [
    {
      "name": "678cb6b9",
      "displayName": "GBIF Biodiversity Dashboard",
      "layout": [
        {
          "widget": {
            "name": "title",
            "multilineTextboxSpec": {
              "lines": [
                "# GBIF Biodiversity Data Dashboard"
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 1
          }
        },
        {
          "widget": {
            "name": "counter_observations",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "gbif_data",
                  "fields": [
                    {
                      "name": "measure(total_observations)",
                      "expression": "MEASURE(`total_observations`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "frame": {
                "title": "Total Observations",
                "showTitle": true
              },
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "measure(total_observations)",
                  "rowNumber": 0
                }
              },
              "data": {
                "queryName": "main_query"
              }
            }
          },
          "position": {
            "x": 0,
            "y": 1,
            "width": 4,
            "height": 2
          }
        },
